// =========================================================
// КОРИСТУВАЧІ ТА ПРОФІЛЬ
// =========================================================

Table "users" {
  "id" INTEGER [unique, not null, increment]
  "email" VARCHAR(255) [not null]
  "full_name" VARCHAR(255) [not null]
  "nickname" VARCHAR(255) [not null]
  "password_hash" VARCHAR(255) [not null]
  "avatar" TEXT
  "gender" VARCHAR(50)
  "birth_date" DATE
  "height" INTEGER
  "weight" DECIMAL(10,2)
  "activity_level" VARCHAR(50)
  "fitness_goal" VARCHAR(50)
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (email) [unique, name: 'idx_users_email_lower', note: 'LOWER(email)']
    (nickname) [unique, name: 'idx_users_nickname_lower', note: 'LOWER(nickname)']
  }
}

Table "settings" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [unique, not null]
  "calorie_goal" INTEGER
  "water_goal" INTEGER
  "protein_goal" INTEGER
  "fat_goal" INTEGER
  "carb_goal" INTEGER

  Indexes {
    id [pk]
  }
}

Table "units" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null, note: "'g', 'ml', 'pcs', 'cup', '%'"]

  Indexes {
    id [pk]
  }
}

Table "metric_types" {
  "id" INTEGER [unique, not null, increment]
  "unit_id" INTEGER
  "name" VARCHAR(255) [not null, note: "'Weight', 'Neck size'"]

  Indexes {
    id [pk]
  }
}

Table "body_metrics" {
  "id" INTEGER [unique, not null, increment]
  "metric_type_id" INTEGER [not null]
  "user_id" INTEGER [not null]
  "value" DECIMAL(10,2) [not null, note: 'CHECK: value > 0']
  "recorded_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (user_id, recorded_at) [name: 'idx_body_metrics_user_date']
  }
}

// =========================================================
// ДОВІДНИКИ ТРЕНУВАНЬ
// =========================================================

Table "equipments" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "user_id" INTEGER

  Indexes {
    id [pk]
  }
}

Table "muscles" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "tracking_metrics" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(50) [unique, not null, note: "'WEIGHT', 'REPS', 'DURATION', 'DISTANCE', 'VOLUME', 'ESTIMATED_1RM'"]

  Indexes {
    id [pk]
  }
}

Table "tracking_types" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "visibility_type" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null, note: "'Public', 'Private', 'Friends Only'"]

  Indexes {
    id [pk]
  }
}

Table "exercises" {
  "id" INTEGER [unique, not null, increment]
  "equipment_id" INTEGER
  "tracking_type_id" INTEGER
  "user_id" INTEGER
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "description" TEXT
  "image_url" VARCHAR(512)
  "deleted_at" TIMESTAMPTZ

  Indexes {
    id [pk]
    (name) [unique, name: 'idx_exercises_system_name', note: 'LOWER(name), WHERE user_id IS NULL']
    (deleted_at) [name: 'idx_exercises_deleted_at', note: 'WHERE deleted_at IS NULL']
    (user_id) [name: 'idx_exercises_user']
  }
}

Table "exercise_muscles" {
  "id" INTEGER [unique, not null, increment]
  "exercise_id" INTEGER [not null]
  "muscle_id" INTEGER [not null]
  "impact_percentage" INTEGER [default: 100, note: 'CHECK: 0 <= impact_percentage <= 100']
  "is_primary" BOOLEAN [default: true]

  Indexes {
    id [pk]
    (exercise_id, muscle_id) [unique, name: 'idx_unique_exercise_muscle']
    (muscle_id) [name: 'idx_exercise_muscles_muscle']
  }
}

// =========================================================
// ТРЕНУВАННЯ (LOGS)
// =========================================================

Table "workouts" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "status" VARCHAR(50) [not null, default: 'IN_PROGRESS']
  "started_at" TIMESTAMPTZ [not null, default: `now()`]
  "ended_at" TIMESTAMPTZ
  "description" TEXT
  "calories" DECIMAL(10,2) [default: 0.00, note: 'CHECK: calories >= 0']
  "avg_heart_rate" INTEGER [note: 'CHECK: avg_heart_rate > 0']
  "max_heart_rate" INTEGER [note: 'CHECK: max_heart_rate > 0']
  "rpe" INTEGER [note: 'CHECK: rpe BETWEEN 1 AND 10']
  "feeling_score" INTEGER [note: 'CHECK: feeling_score BETWEEN 1 AND 5']

  Indexes {
    id [pk]
    (user_id, started_at) [name: 'idx_workouts_user_date']
  }
}

Table "log_exercises" {
  "id" INTEGER [unique, not null, increment]
  "workout_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "notes" TEXT
  "rest_time" INTEGER [default: 0, note: 'CHECK: rest_time >= 0']

  Indexes {
    id [pk]
    (workout_id) [name: 'idx_log_exercises_workout']
    (exercise_id) [name: 'idx_log_exercises_exercise']
  }
}

Table "log_sets" {
  "id" INTEGER [unique, not null, increment]
  "log_exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "weight" DECIMAL(10,2) [note: 'CHECK: weight >= 0']
  "reps" INTEGER [note: 'CHECK: reps >= 0']
  "duration" INTEGER [note: 'CHECK: duration >= 0']
  "distance" DECIMAL(10,2) [note: 'CHECK: distance >= 0']
  "is_completed" BOOLEAN [default: false]
  "is_pr" BOOLEAN [default: false]
  "achievement_id" INTEGER

  Indexes {
    id [pk]
    (log_exercise_id) [name: 'idx_log_sets_exercise']
    (achievement_id) [name: 'idx_log_sets_achievement']
  }
}

// =========================================================
// ШАБЛОНИ ТРЕНУВАНЬ
// =========================================================

Table "workout_templates" {
  "id" INTEGER [unique, not null, increment]
  "visibility_type_id" INTEGER [default: 1]
  "creator_id" INTEGER
  "name" VARCHAR(255) [not null]
  "description" TEXT

  Indexes {
    id [pk]
  }
}

Table "template_exercises" {
  "id" INTEGER [unique, not null, increment]
  "workout_template_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "rest_time" INTEGER [default: 60]

  Indexes {
    id [pk]
    (workout_template_id) [name: 'idx_template_exercises_template']
  }
}

Table "template_sets" {
  "id" INTEGER [unique, not null, increment]
  "template_exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "weight" DECIMAL(10,2) [default: 0.00, note: 'CHECK: weight >= 0']
  "reps" INTEGER [default: 0, note: 'CHECK: reps >= 0']
  "duration" INTEGER [default: 0]
  "distance" DECIMAL(10,2) [default: 0.00]

  Indexes {
    id [pk]
    (template_exercise_id) [name: 'idx_template_sets_exercise']
  }
}

Table "user_workout_templates" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "workout_template_id" INTEGER [not null]

  Indexes {
    id [pk]
    (user_id) [name: 'idx_user_workout_templates_user']
    (workout_template_id) [name: 'idx_user_workout_templates_template']
  }
}

Table "friend_statuses" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(50) [unique, not null, note: "'PENDING', 'ACCEPTED'"]

  Indexes {
    id [pk]
  }
}

Table "user_friends" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "friend_id" INTEGER [not null]
  "status_id" INTEGER [not null]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Note: 'CHECK: user_id != friend_id'

  Indexes {
    id [pk]
    (user_id, friend_id) [unique, name: 'idx_unique_friendship', note: 'LEAST(user_id, friend_id), GREATEST(user_id, friend_id)']
    (friend_id) [name: 'idx_friend_status']
  }
}

// =========================================================
// ДОСЯГНЕННЯ ТА РЕКОРДИ
// =========================================================

Table "achievements" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "description" TEXT [not null]
  "type" VARCHAR(50) [not null]
  "threshold" DECIMAL(14,2) [not null]
  "exercise_id" INTEGER
  "tracking_metric_id" INTEGER

  Indexes {
    id [pk]
    (type) [name: 'idx_achievements_type']
    (exercise_id) [name: 'idx_achievements_exercise']
  }
}

Table "user_achievements" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "achievement_id" INTEGER [not null]
  "unlocked_at" TIMESTAMPTZ [not null, default: `now()`]
  "value" DECIMAL(14,2) [not null, default: 0]

  Indexes {
    id [pk]
    (user_id, achievement_id) [unique, name: 'UQ_user_achievement']
    (achievement_id) [name: 'idx_user_achievements_achievement']
  }
}

Table "user_exercise_records" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "log_set_id" INTEGER
  "metric_type_id" INTEGER [not null]
  "value" DECIMAL(10,2) [not null]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (user_id, exercise_id, metric_type_id, created_at) [name: 'IDX_user_exercise_record']
    (log_set_id) [name: 'idx_user_exercise_records_log_set']
  }
}

// =========================================================
// ХАРЧУВАННЯ (NUTRITION)
// =========================================================

Table "foods" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "brand" VARCHAR(255)
  "image_url" VARCHAR(512)
  "creator_id" INTEGER
  "deleted_at" TIMESTAMPTZ

  Indexes {
    id [pk]
    (name, brand) [unique, name: 'idx_foods_system_name', note: 'LOWER(name), COALESCE(LOWER(brand),""), WHERE creator_id IS NULL']
  }
}

Table "nutrition_facts" {
  "id" INTEGER [unique, not null, increment]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "amount" DECIMAL(10,2) [not null, default: 1.00, note: 'CHECK: amount > 0']
  "calories" DECIMAL(10,2) [not null, default: 0.00, note: 'CHECK: calories >= 0']
  "proteins" DECIMAL(10,2) [not null, default: 0.00, note: 'CHECK: proteins >= 0']
  "fats" DECIMAL(10,2) [not null, default: 0.00, note: 'CHECK: fats >= 0']
  "carbs" DECIMAL(10,2) [not null, default: 0.00, note: 'CHECK: carbs >= 0']

  Indexes {
    id [pk]
    (food_id) [name: 'idx_nutrition_facts_food']
  }
}

Table "meal_types" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null, note: "'Breakfast', 'Lunch', 'Dinner', 'Snack'"]

  Indexes {
    id [pk]
  }
}

Table "meal_plans" {
  "id" INTEGER [unique, not null, increment]
  "creator_id" INTEGER
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "description" TEXT
  "total_days" INTEGER [default: 0, note: 'CHECK: total_days >= 0']

  Indexes {
    id [pk]
  }
}

Table "plan_days" {
  "id" INTEGER [unique, not null, increment]
  "meal_plan_id" INTEGER [not null]
  "day_number" INTEGER [not null, note: 'CHECK: day_number > 0']
  "notes" TEXT

  Indexes {
    id [pk]
    (meal_plan_id) [name: 'idx_plan_days_plan']
  }
}

Table "plan_meals" {
  "id" INTEGER [unique, not null, increment]
  "plan_day_id" INTEGER [not null]
  "meal_type_id" INTEGER [not null]
  "order" INTEGER [not null]
  "time_suggestion" TIME

  Indexes {
    id [pk]
    (plan_day_id) [name: 'idx_plan_meals_day']
  }
}

Table "plan_meal_items" {
  "id" INTEGER [unique, not null, increment]
  "plan_meal_id" INTEGER [not null]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "amount" DECIMAL(10,2) [not null, note: 'CHECK: amount > 0']

  Indexes {
    id [pk]
    (plan_meal_id) [name: 'idx_plan_meal_items_meal']
    (food_id) [name: 'idx_plan_meal_items_food']
  }
}

Table "user_meal_plans" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "meal_plan_id" INTEGER [not null]
  "is_active" BOOLEAN [not null, default: true]
  "started_at" DATE [not null, default: `CURRENT_DATE`]

  Indexes {
    id [pk]
    (user_id) [unique, name: 'idx_unique_active_user_plan', note: 'WHERE is_active = true']
    (meal_plan_id) [name: 'idx_user_meal_plans_plan']
  }
}

Table "log_meals" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "meal_type_id" INTEGER
  "name" VARCHAR(255)
  "original_plan_meal_id" INTEGER [note: 'Optional: reference to plan_meals if logged from a plan']
  "consumed_at" TIMESTAMPTZ [not null, default: `now()`]
  "day_log_date" DATE [not null, default: `CURRENT_DATE`]

  Indexes {
    id [pk]
    (user_id, day_log_date) [name: 'idx_log_meals_date']
  }
}

Table "log_meal_items" {
  "id" INTEGER [unique, not null, increment]
  "log_meal_id" INTEGER [not null]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "amount" DECIMAL(10,2) [not null, note: 'CHECK: amount > 0']
  "calculated_weight_g" DECIMAL(10,2) [note: 'Pre-calculated grams for easier calorie computation']

  Indexes {
    id [pk]
    (log_meal_id) [name: 'idx_log_meal_items_meal']
    (food_id) [name: 'idx_log_meal_items_food']
  }
}

Table "water_logs" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "amount_ml" INTEGER [not null, note: 'CHECK: amount_ml > 0']
  "consumed_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (user_id, consumed_at) [name: 'idx_water_logs_date']
  }
}

Table "daily_goals" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "date" DATE [not null]
  "calorie_goal" INTEGER
  "water_goal" INTEGER
  "protein_goal" INTEGER
  "fat_goal" INTEGER
  "carb_goal" INTEGER

  Indexes {
    id [pk]
    (user_id, date) [unique]
  }
}

// =========================================================
// FOREIGN KEYS & RELATIONS
// =========================================================

// Profile
Ref: settings.user_id > users.id [delete: cascade]

// Metrics
Ref: body_metrics.user_id > users.id [delete: cascade]
Ref: body_metrics.metric_type_id > metric_types.id
Ref: metric_types.unit_id > units.id

// Exercises & Muscles
Ref: exercise_muscles.exercise_id > exercises.id [delete: cascade]
Ref: exercise_muscles.muscle_id > muscles.id
Ref: exercises.tracking_type_id > tracking_types.id
Ref: exercises.equipment_id > equipments.id
Ref: exercises.user_id > users.id [delete: cascade]
Ref: exercises.visibility_type_id > visibility_type.id
Ref: equipments.user_id > users.id [delete: cascade]

// Workouts
Ref: workouts.visibility_type_id > visibility_type.id
Ref: workouts.user_id > users.id [delete: cascade]
Ref: log_exercises.exercise_id > exercises.id
Ref: log_exercises.workout_id > workouts.id [delete: cascade]
Ref: log_sets.log_exercise_id > log_exercises.id [delete: cascade]
Ref: log_sets.achievement_id > achievements.id [delete: set null]

// Workout Templates
Ref: workout_templates.visibility_type_id > visibility_type.id
Ref: workout_templates.creator_id > users.id [delete: cascade]
Ref: template_exercises.workout_template_id > workout_templates.id [delete: cascade]
Ref: template_exercises.exercise_id > exercises.id
Ref: template_sets.template_exercise_id > template_exercises.id [delete: cascade]
Ref: user_workout_templates.workout_template_id > workout_templates.id [delete: cascade]
Ref: user_workout_templates.user_id > users.id [delete: cascade]

// Social
Ref: user_friends.user_id > users.id [delete: cascade]
Ref: user_friends.friend_id > users.id [delete: cascade]
Ref: user_friends.status_id > friend_statuses.id

// Achievements & Records
Ref: achievements.exercise_id > exercises.id [delete: cascade]
Ref: achievements.tracking_metric_id > tracking_metrics.id [delete: set null]
Ref: user_achievements.user_id > users.id [delete: cascade]
Ref: user_achievements.achievement_id > achievements.id [delete: cascade]
Ref: user_exercise_records.user_id > users.id [delete: cascade]
Ref: user_exercise_records.exercise_id > exercises.id [delete: cascade]
Ref: user_exercise_records.log_set_id > log_sets.id [delete: cascade]
Ref: user_exercise_records.metric_type_id > tracking_metrics.id

// Nutrition Plan
Ref: meal_plans.visibility_type_id > visibility_type.id
Ref: meal_plans.creator_id > users.id [delete: no action]
Ref: plan_days.meal_plan_id > meal_plans.id [delete: cascade]
Ref: plan_meals.plan_day_id > plan_days.id [delete: cascade]
Ref: plan_meals.meal_type_id > meal_types.id
Ref: plan_meal_items.plan_meal_id > plan_meals.id [delete: cascade]
Ref: plan_meal_items.food_id > foods.id
Ref: plan_meal_items.unit_id > units.id
Ref: user_meal_plans.user_id > users.id [delete: cascade]
Ref: user_meal_plans.meal_plan_id > meal_plans.id [delete: cascade]

// Nutrition Log
Ref: log_meals.user_id > users.id [delete: cascade]
Ref: log_meals.meal_type_id > meal_types.id
Ref: log_meals.original_plan_meal_id > plan_meals.id [delete: set null]
Ref: log_meal_items.log_meal_id > log_meals.id [delete: cascade]
Ref: log_meal_items.food_id > foods.id
Ref: log_meal_items.unit_id > units.id

// Water
Ref: water_logs.user_id > users.id [delete: cascade]

// Daily Goals
Ref: daily_goals.user_id > users.id [delete: cascade]

// Foods
Ref: foods.creator_id > users.id [delete: set null]
Ref: nutrition_facts.food_id > foods.id [delete: cascade]
Ref: nutrition_facts.unit_id > units.id
