# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Set to "false" when connecting to a local Postgres without SSL (e.g. Docker).
# Leave unset or "true" for managed providers such as Supabase.
DATABASE_SSL=true

# Server
PORT=4000

# JWT
JWT_SECRET=your-secret-key-change-in-production

# ETL (apps/api/etl)
# Free API key from https://api.data.gov/signup/ — required for USDA FoodData Central source.
USDA_FDC_API_KEY=
# Optional override for the ExerciseDB endpoint (self-host or alternate mirror).
# EXERCISEDB_BASE_URL=https://exercisedb-api.vercel.app
