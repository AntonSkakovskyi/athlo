{
  "expo": {
    "name": "Athlo",
    "slug": "athlo",
    "scheme": "athlo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0906"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.student.athlo",
      "adaptiveIcon": {
        "backgroundColor": "#0A0906",
        "foregroundImage": "./assets/icon.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d9e2fdef-c9a0-4617-b15c-b74e19a198a1"
      }
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Athlo to access your photos to set a profile picture."
        }
      ]
    ]
  }
}
