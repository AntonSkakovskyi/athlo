// =========================================================
// USERS & PROFILE
// =========================================================

Table "users" {
  "id" INTEGER [unique, not null, increment]
  "email" VARCHAR(255) [unique, not null]
  "full_name" VARCHAR(255) [not null]
  "nickname" VARCHAR(255) [unique, not null]
  "password_hash" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "settings" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [unique, not null]
  "water_goal" INTEGER
  "protein_goal" INTEGER
  "fat_goal" INTEGER
  "carb_goal" INTEGER

  Indexes {
    id [pk]
  }
}

Table "units" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "metric_types" {
  "id" INTEGER [unique, not null, increment]
  "unit_id" INTEGER
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "body_metrics" {
  "id" INTEGER [unique, not null, increment]
  "metric_type_id" INTEGER [not null]
  "user_id" INTEGER [not null]
  "value" DECIMAL(10,2) [not null]
  "recorded_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `value > 0`
  }

  Indexes {
    id [pk]
    (user_id, recorded_at) [name: "idx_body_metrics_user_date"]
  }
}

// =========================================================
// EXERCISE CATALOG
// =========================================================

Table "equipments" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "user_id" INTEGER

  Indexes {
    id [pk]
  }
}

Table "muscles" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "name_en" VARCHAR(255)
  "image_url" VARCHAR(512)
  "image_url_secondary" VARCHAR(512)

  Indexes {
    id [pk]
  }
}

Table "tracking_types" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "exercise_categories" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(50) [unique, not null]

  Indexes {
    id [pk]
  }
}

Table "exercises" {
  "id" INTEGER [unique, not null, increment]
  "equipment_id" INTEGER
  "tracking_type_id" INTEGER
  "user_id" INTEGER
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "description" TEXT
  "instructions" TEXT
  "image_url" VARCHAR(512)
  "gif_url" VARCHAR(512)

  Indexes {
    id [pk]
    (name) [unique, name: "idx_exercises_system_name", note: "WHERE user_id IS NULL"]
  }
}

Table "exercise_muscles" {
  "id" INTEGER [unique, not null, increment]
  "exercise_id" INTEGER [not null]
  "muscle_id" INTEGER [not null]
  "impact_percentage" INTEGER [default: 100]
  "is_primary" BOOLEAN [default: true]

  Checks {
    `impact_percentage >= 0 AND impact_percentage <= 100`
  }

  Indexes {
    id [pk]
    (exercise_id, muscle_id) [unique, name: "idx_unique_exercise_muscle"]
  }
}

Table "visibility_type" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

// =========================================================
// WORKOUTS (LOGS)
// =========================================================

Table "workouts" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "status" VARCHAR(50) [not null, default: 'IN_PROGRESS']
  "started_at" TIMESTAMPTZ [not null, default: `now()`]
  "ended_at" TIMESTAMPTZ
  "description" TEXT
  "calories" DECIMAL(10,2) [check: `calories >= 0`, default: 0.00]
  "avg_heart_rate" INTEGER [check: `avg_heart_rate > 0`]
  "max_heart_rate" INTEGER [check: `max_heart_rate > 0`]
  "rpe" INTEGER [check: `rpe BETWEEN 1 AND 10`]
  "feeling_score" INTEGER [check: `feeling_score BETWEEN 1 AND 5`]

  Indexes {
    id [pk]
    (user_id, started_at) [name: "idx_workouts_user_date"]
  }
}

Table "log_exercises" {
  "id" INTEGER [unique, not null, increment]
  "workout_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "notes" TEXT
  "rest_time" INTEGER [check: `rest_time >= 0`, default: 0]

  Indexes {
    id [pk]
    workout_id [name: "idx_log_exercises_workout"]
  }
}

Table "log_sets" {
  "id" INTEGER [unique, not null, increment]
  "log_exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "weight" DECIMAL(10,2) [check: `weight >= 0`, default: 0.00]
  "reps" INTEGER [check: `reps >= 0`, default: 0]
  "duration" INTEGER [check: `duration >= 0`, default: 0]
  "distance" DECIMAL(10,2) [check: `distance >= 0`, default: 0.00]
  "is_completed" BOOLEAN [default: false]
  "is_pr" BOOLEAN [default: false]
  "achievement_id" INTEGER

  Indexes {
    id [pk]
    log_exercise_id [name: "idx_log_sets_exercise"]
  }
}

// =========================================================
// WORKOUT TEMPLATES
// =========================================================

Table "workout_templates" {
  "id" INTEGER [unique, not null, increment]
  "visibility_type_id" INTEGER [default: 1]
  "creator_id" INTEGER
  "name" VARCHAR(255) [not null]
  "description" TEXT

  Indexes {
    id [pk]
  }
}

Table "template_exercises" {
  "id" INTEGER [unique, not null, increment]
  "workout_template_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "rest_time" INTEGER [default: 60]

  Indexes {
    id [pk]
  }
}

Table "template_sets" {
  "id" INTEGER [unique, not null, increment]
  "template_exercise_id" INTEGER [not null]
  "order" INTEGER [not null]
  "weight" DECIMAL(10,2) [check: `weight >= 0`, default: 0.00]
  "reps" INTEGER [check: `reps >= 0`, default: 0]
  "duration" INTEGER [default: 0]
  "distance" DECIMAL(10,2) [default: 0.00]

  Indexes {
    id [pk]
  }
}

Table "user_workout_templates" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "workout_template_id" INTEGER [not null]

  Indexes {
    id [pk]
  }
}

// =========================================================
// SOCIAL & ACHIEVEMENTS
// =========================================================

Table "user_friends" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "friend_id" INTEGER [not null]
  "status" VARCHAR(20) [not null, default: 'PENDING']
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Checks {
    `user_id != friend_id`
  }

  Indexes {
    id [pk]
    (user_id, friend_id) [name: "idx_unique_friendship"]
    (friend_id, status) [name: "idx_friend_status"]
  }
}

Table "achievements" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "description" TEXT [not null]
  "type" VARCHAR(50) [not null]
  "threshold" DECIMAL(14,2) [not null]
  "exercise_id" INTEGER
  "tracking_metric" VARCHAR(50)
  "icon_url" VARCHAR(512)
  "order" INTEGER [not null, default: 0]

  Indexes {
    id [pk]
    type [name: "idx_achievements_type"]
  }
}

Table "user_achievements" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "achievement_id" INTEGER [not null]
  "unlocked_at" TIMESTAMPTZ [not null, default: `now()`]
  "value" DECIMAL(14,2) [not null, default: 0]

  Indexes {
    id [pk]
    (user_id, achievement_id) [unique, name: "UQ_user_achievement"]
  }
}

Table "user_exercise_records" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "exercise_id" INTEGER [not null]
  "log_set_id" INTEGER
  "metric_type" VARCHAR(50) [not null]
  "value" DECIMAL(10,2) [not null]
  "created_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (user_id, exercise_id, metric_type, created_at) [name: "IDX_user_exercise_record"]
  }
}

// =========================================================
// NUTRITION
// =========================================================

Table "foods" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]
  "brand" VARCHAR(255)
  "calories" DECIMAL(10,2) [not null, check: `calories >= 0`, default: 0.00]
  "proteins" DECIMAL(10,2) [not null, check: `proteins >= 0`, default: 0.00]
  "fats" DECIMAL(10,2) [not null, check: `fats >= 0`, default: 0.00]
  "carbs" DECIMAL(10,2) [not null, check: `carbs >= 0`, default: 0.00]
  "fiber" DECIMAL(10,2) [check: `fiber >= 0`, default: 0.00]
  "sugar" DECIMAL(10,2) [check: `sugar >= 0`, default: 0.00]
  "sodium_mg" DECIMAL(10,2) [check: `sodium_mg >= 0`, default: 0.00]
  "serving_size_g" DECIMAL(10,2) [check: `serving_size_g > 0`]
  "image_url" VARCHAR(512)
  "barcode" VARCHAR(50)
  "creator_id" INTEGER

  Indexes {
    id [pk]
    barcode [unique, name: "idx_foods_barcode"]
    (name, brand) [unique, name: "idx_foods_system_name"]
  }
}

Table "food_units" {
  "id" INTEGER [unique, not null, increment]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "conversion_factor" DECIMAL(10,2) [not null]

  Indexes {
    id [pk]
  }
}

Table "meal_types" {
  "id" INTEGER [unique, not null, increment]
  "name" VARCHAR(255) [not null]

  Indexes {
    id [pk]
  }
}

Table "meal_plans" {
  "id" INTEGER [unique, not null, increment]
  "creator_id" INTEGER
  "visibility_type_id" INTEGER [not null, default: 1]
  "name" VARCHAR(255) [not null]
  "description" TEXT
  "total_days" INTEGER [check: `total_days > 0`, default: 1]

  Indexes {
    id [pk]
  }
}

Table "plan_days" {
  "id" INTEGER [unique, not null, increment]
  "meal_plan_id" INTEGER [not null]
  "day_number" INTEGER [not null, check: `day_number > 0`]
  "notes" TEXT

  Indexes {
    id [pk]
  }
}

Table "plan_meals" {
  "id" INTEGER [unique, not null, increment]
  "plan_day_id" INTEGER [not null]
  "meal_type_id" INTEGER [not null]
  "order" INTEGER [not null]
  "time_suggestion" TIME

  Indexes {
    id [pk]
  }
}

Table "plan_meal_items" {
  "id" INTEGER [unique, not null, increment]
  "plan_meal_id" INTEGER [not null]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "amount" DECIMAL(10,2) [not null, check: `amount > 0`]

  Indexes {
    id [pk]
  }
}

Table "user_meal_plans" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "meal_plan_id" INTEGER [not null]
  "is_active" BOOLEAN [not null, default: true]
  "started_at" DATE [not null, default: `CURRENT_DATE`]

  Indexes {
    id [pk]
    user_id [unique, name: "idx_unique_active_user_plan"]
  }
}

Table "log_meals" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "meal_type_id" INTEGER
  "name" VARCHAR(255)
  "original_plan_meal_id" INTEGER
  "consumed_at" TIMESTAMPTZ [not null, default: `now()`]
  "day_log_date" DATE [not null, default: `CURRENT_DATE`]

  Indexes {
    id [pk]
    (user_id, day_log_date) [name: "idx_log_meals_date"]
  }
}

Table "log_meal_items" {
  "id" INTEGER [unique, not null, increment]
  "log_meal_id" INTEGER [not null]
  "food_id" INTEGER [not null]
  "unit_id" INTEGER [not null]
  "amount" DECIMAL(10,2) [not null, check: `amount > 0`]
  "calculated_weight_g" DECIMAL(10,2)

  Indexes {
    id [pk]
  }
}

Table "water_logs" {
  "id" INTEGER [unique, not null, increment]
  "user_id" INTEGER [not null]
  "amount_ml" INTEGER [not null, check: `amount_ml > 0`]
  "consumed_at" TIMESTAMPTZ [not null, default: `now()`]

  Indexes {
    id [pk]
    (user_id, consumed_at) [name: "idx_water_logs_date"]
  }
}

// =========================================================
// RELATIONSHIPS
// =========================================================

Ref: "users"."id" < "settings"."user_id" [delete: cascade]

Ref: "users"."id" < "body_metrics"."user_id" [delete: cascade]
Ref: "metric_types"."id" < "body_metrics"."metric_type_id"
Ref: "units"."id" < "metric_types"."unit_id"

Ref: "exercises"."id" < "exercise_muscles"."exercise_id" [delete: cascade]
Ref: "muscles"."id" < "exercise_muscles"."muscle_id"
Ref: "tracking_types"."id" < "exercises"."tracking_type_id"
Ref: "equipments"."id" < "exercises"."equipment_id"
Ref: "users"."id" < "exercises"."user_id" [delete: cascade]
Ref: "visibility_type"."id" < "exercises"."visibility_type_id"
Ref: "users"."id" < "equipments"."user_id" [delete: cascade]

Ref: "visibility_type"."id" < "workouts"."visibility_type_id"
Ref: "users"."id" < "workouts"."user_id" [delete: cascade]
Ref: "exercises"."id" < "log_exercises"."exercise_id"
Ref: "workouts"."id" < "log_exercises"."workout_id" [delete: cascade]
Ref: "log_exercises"."id" < "log_sets"."log_exercise_id" [delete: cascade]

Ref: "visibility_type"."id" < "workout_templates"."visibility_type_id"
Ref: "users"."id" < "workout_templates"."creator_id" [delete: cascade]
Ref: "workout_templates"."id" < "template_exercises"."workout_template_id" [delete: cascade]
Ref: "exercises"."id" < "template_exercises"."exercise_id"
Ref: "template_exercises"."id" < "template_sets"."template_exercise_id" [delete: cascade]
Ref: "workout_templates"."id" < "user_workout_templates"."workout_template_id" [delete: cascade]
Ref: "users"."id" < "user_workout_templates"."user_id" [delete: cascade]

Ref: "users"."id" < "user_friends"."user_id" [delete: cascade]
Ref: "users"."id" < "user_friends"."friend_id" [delete: cascade]

Ref: "exercises"."id" < "achievements"."exercise_id" [delete: cascade]
Ref: "users"."id" < "user_achievements"."user_id" [delete: cascade]
Ref: "achievements"."id" < "user_achievements"."achievement_id" [delete: cascade]
Ref: "users"."id" < "user_exercise_records"."user_id" [delete: cascade]
Ref: "exercises"."id" < "user_exercise_records"."exercise_id" [delete: cascade]
Ref: "log_sets"."id" < "user_exercise_records"."log_set_id" [delete: cascade]

Ref: "visibility_type"."id" < "meal_plans"."visibility_type_id"
Ref: "users"."id" < "meal_plans"."creator_id" [delete: no action]
Ref: "meal_plans"."id" < "plan_days"."meal_plan_id" [delete: cascade]
Ref: "plan_days"."id" < "plan_meals"."plan_day_id" [delete: cascade]
Ref: "meal_types"."id" < "plan_meals"."meal_type_id"
Ref: "plan_meals"."id" < "plan_meal_items"."plan_meal_id" [delete: cascade]
Ref: "foods"."id" < "plan_meal_items"."food_id"
Ref: "units"."id" < "plan_meal_items"."unit_id"
Ref: "users"."id" < "user_meal_plans"."user_id" [delete: cascade]
Ref: "meal_plans"."id" < "user_meal_plans"."meal_plan_id" [delete: cascade]

Ref: "users"."id" < "log_meals"."user_id" [delete: cascade]
Ref: "meal_types"."id" < "log_meals"."meal_type_id"
Ref: "plan_meals"."id" < "log_meals"."original_plan_meal_id" [delete: set null]
Ref: "log_meals"."id" < "log_meal_items"."log_meal_id" [delete: cascade]
Ref: "foods"."id" < "log_meal_items"."food_id"
Ref: "units"."id" < "log_meal_items"."unit_id"

Ref: "users"."id" < "water_logs"."user_id" [delete: cascade]

Ref: "users"."id" < "foods"."creator_id" [delete: set null]
Ref: "foods"."id" < "food_units"."food_id" [delete: cascade]
Ref: "units"."id" < "food_units"."unit_id" [delete: cascade]
